{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"incremental": false,
		"declaration": true,
		"sourceMap": false,
		"declarationMap": false,
		"skipLibCheck": true,
		"outDir": "./dist/",
	},
	"include": [
		"nodes/**/*",
		"credentials/**/*",
	],
	"exclude": [
		"node_modules",
		"dist",
		"scripts",
		"**/*.test.ts",
		"**/__testutils__/**",
	],
}
